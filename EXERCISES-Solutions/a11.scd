/*
VOLTAGE CONTROL
	VCO, VCA, VCF
Voltage control is nowadays is a skeuomorph?
It refers to when one signal source is used to control the parameters of another e.g. one UGen's output controls the input of another.
The term comes from electronic music (with actual synths) where the voltage generated by one module would literally control the input of another module.

When using UGens for control, use the .kr method for computational efficiency.
kr does not trigger audio.
*/


s.boot;

/*
Line - generates a ramp. start, stop, duration, mul, add, doneAction
*/

{SinOsc.ar(freq: 400, mul: 0.7)}.play;
{SinOsc.ar(freq: Line.kr(200, 2000, 10), mul: Line.kr(0.9, 0.2, 10))}.scope;

/*
VIBRATO
(
{
var vibrato;
vibrato = SinOsc.ar(freq: 5, mul: 5, add: 440);
SinOsc.ar(vibrato, mul: 0.5)
}.play
)
*/
(
var f0, fvc0;
var vibratof, vibratoscale;
// the vibrato is gotten by a small signal sine wave riding a DC level
f0 = 440; // dc level 440 Hz. We will deviate by a sine with small amplitude
// the 'add' parameter automatically shifts outputs by the offset.

// from experimentation, the modulator frequency and amplitude have to be small to get the classic vibrato effect.
vibratof = 8.3;
//vibratoscale = 10.5;
vibratoscale = {Line.kr(0.0, 25.5, 1)};
fvc0 = {SinOsc.kr(freq: vibratof, mul: vibratoscale, add: f0)};

{SinOsc.ar(freq: fvc0)}.play;
)



s.quit;